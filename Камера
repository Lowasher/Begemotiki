extends Node3D

@export var target: NodePath # Ссылка на бублик (DonutShip)
@export var distance: float = 12.0
@export var min_distance: float = 4.0
@export var max_distance: float = 30.0
@export var mouse_sensitivity: float = 0.005
@export var zoom_speed: float = 1.5

var target_node: Node3D
var pitch: float = -30.0
var yaw: float = 0.0

@onready var pitch_node: Node3D = $PitchNode
@onready var camera: Camera3D = $PitchNode/Camera3D

func _ready():
	if not target.is_empty():
		target_node = get_node(target)
	camera.position.z = distance

func _unhandled_input(event):
	# Вращение камеры при зажатой правой кнопке мыши
	if event is InputEventMouseMotion and Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
		yaw -= event.relative.x * mouse_sensitivity
		pitch -= event.relative.y * mouse_sensitivity
		pitch = clamp(pitch, -85.0, 15.0)
		
	# Приближение и отдаление колесиком мыши
	if event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_WHEEL_UP:
			distance = clamp(distance - zoom_speed, min_distance, max_distance)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			distance = clamp(distance + zoom_speed, min_distance, max_distance)

func _process(delta):
	if target_node:
		# Плавное или прямое слежение за позицией бублика
		global_position = target_node.global_position
		
	# Применяем вращения и дистанцию зума
	rotation.y = yaw
	pitch_node.rotation.x = deg_to_rad(pitch)
	camera.position.z = distance
